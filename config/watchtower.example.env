# Copy to .env and export the variables, or set them in your shell.
# Demo mode ignores WT_DECIDER and WT_EMBEDDER and stays offline.

WT_DB=data/watchtower.db
WT_DECIDER=auto
WT_DECIDER_URL=http://127.0.0.1:8009
WT_DECIDER_MODEL=kev-latest
# WT_DECIDER_API_KEY=
WT_DECIDER_FALLBACK=1

WT_OLLAMA_URL=http://127.0.0.1:11434
WT_OLLAMA_MODEL=qwen2.5:3b

# auto tries the model below, then the hashing embedder.
# Set qwen after: pip install 'watch-tower[embed]'
WT_EMBEDDER=auto
WT_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-0.6B

# ntfy topic. Use an unguessable name. Leave empty to print alerts only.
# WT_NTFY_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic
# WT_APPRISE_URLS=

WT_OPENALEX_KEY=
WT_OPENALEX_MAILTO=
WT_FEEDBACK_BASE=http://127.0.0.1:8787
