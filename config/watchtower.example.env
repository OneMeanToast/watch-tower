# Copy to .env and export the variables, or set them in your shell.
# Demo mode ignores WT_DECIDER and WT_EMBEDDER and stays offline.

WT_DB=data/watchtower.db
# auto: Jev when JEV_API_KEY is set, else local Kev, else Ollama, else lexical.
# jev, kev, lexical, and ollama are explicit. Demo mode ignores this and stays lexical.
WT_DECIDER=auto
# Official TypeSafe API. Do not point this at a reseller host.
JEV_BASE_URL=https://api.typesafe.ai
# JEV_API_KEY=
# Pinned model. jev-latest moves when TypeSafe ships a new release.
JEV_MODEL=jev-1.13.0
# List price is $0.042 per million input tokens. Output tokens are free.
WT_JEV_USD_PER_MTOK=0.042
# 0 disables the cap. Past the cap, items fall through to local Kev, then lexical.
WT_JEV_MONTHLY_USD=10
# Warn in the log and on the Spend panel. Calls continue until the monthly cap.
WT_JEV_DAILY_WARN_USD=1
WT_JEV_PROMPT_VERSION=1
# Manual uploads and private files stay local unless this is 1.
WT_JEV_ALLOW_PRIVATE=0
WT_DECIDER_URL=http://127.0.0.1:8009
# The HTTP model field stays kev-latest. Pin the checkpoint on the Kev process:
#   KEV_DATE_FACTS=1 uv run --extra serve python -m kev.serve \
#     --run jaredpalmer/kev-4b@v1.0 --port 8009
# 32 GB Mac: kev-4b@v1.0. Any Apple Silicon Mac: kev-0.8b@v1.0.
# kev-9b and kev-27b are the larger 1.0 sizes. Older Qwen3 0.6B/4B/8B
# revisions (and the 0.5B on Qwen2.5) are not the current release.
WT_DECIDER_MODEL=kev-latest
# WT_DECIDER_API_KEY=
WT_DECIDER_FALLBACK=1
# Optional second local backend for the uncertain band: ollama or systemone.
WT_ESCALATE=
# heuristic (offline) or deberta (protectai/deberta-v3-base-prompt-injection-v2).
WT_INJECTION_GUARD=heuristic
# Article text for short items and GDELT headlines. Demo mode forces this off.
WT_FETCH_FULLTEXT=1
WT_SPAM_MIN_CLUSTER=3

WT_OLLAMA_URL=http://127.0.0.1:11434
WT_OLLAMA_MODEL=qwen2.5:3b

# auto tries the model below, then the hashing embedder.
# Set qwen after: pip install 'watch-tower[embed]'
WT_EMBEDDER=auto
WT_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-0.6B

# ntfy topic. Use an unguessable name. Leave empty to print alerts only.
# WT_NTFY_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic
# WT_APPRISE_URLS=

WT_OPENALEX_KEY=
WT_OPENALEX_MAILTO=
WT_FEEDBACK_BASE=http://127.0.0.1:8787
